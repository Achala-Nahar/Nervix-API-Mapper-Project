SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DATABASE
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5
NEO4J_URI=neo4j+s://YOUR_NEO4J_HOST
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
SUPABASE_JWK_SET_URI=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
